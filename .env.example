# Offline fixture provider (no network, no API keys). Use this for tests.
# LLM_PROVIDER=fixture
# MODEL_NAME=fixture
# MAX_MESSAGES=1

# Optional Grok CLI headless backend. pytest never invokes this.
# LLM_PROVIDER=grok-cli
# GROK_CLI_BIN=grok
# GROK_CLI_MODEL=grok-4
# GROK_CLI_OUTPUT_FORMAT=plain

# Optional xAI OpenAI-compatible API. Leave unset unless you opt in.
# LLM_PROVIDER=xai
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1

# OpenRouter API Configuration (historical default). Do not commit real keys.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Your site URL (for OpenRouter analytics)
OPENROUTER_SITE_URL=https://github.com/yourusername/solana-gym

# Optional: Your app name (for OpenRouter analytics)
OPENROUTER_APP_NAME=solana-bench

# Optional: Langsmith project info, useful for debugging prompts & environments
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""